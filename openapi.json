            "schema": {
              "type": "string",
              "title": "Chunk Id"
            }
          },
          {
            "name": "context_window",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 3,
              "minimum": 0,
              "default": 1,
              "title": "Context Window"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",

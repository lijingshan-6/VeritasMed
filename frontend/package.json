{
  "name": "frontend",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --strictPort",
    "replay": "node scripts/prepare-replay.mjs && vite --mode replay --host 127.0.0.1 --strictPort",
    "build": "tsc && vite build",
    "build:replay": "node scripts/prepare-replay.mjs && tsc && vite build --mode replay && node -e \"require('fs').copyFileSync('dist/index.html','dist/404.html')\"",
    "preview": "vite preview",
    "generate-types": "openapi-typescript ../openapi.json --default-non-nullable false -o src/types/api.gen.ts",
    "test": "node --experimental-strip-types --test tests/*.test.js"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.10"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.4",
    "axios": "^1.16.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.15.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.2.4",
    "zustand": "^5.0.13"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}

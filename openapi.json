{
  "openapi": "3.1.0",
  "info": {
    "title": "VeritasMed API",
    "description": "Self-verifying medical literature QA backend",
    "version": "0.8.0"
  },
  "paths": {
    "/api/document/{citation}": {
      "get": {
        "summary": "Get Document",
        "operationId": "get_document_api_document__citation__get",
        "parameters": [
          {
            "name": "citation",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Citation"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/chunk/{chunk_id}": {
      "get": {
        "summary": "Get Chunk",
        "description": "Return the chunk and its neighbouring chunks.",
        "operationId": "get_chunk_api_chunk__chunk_id__get",
        "parameters": [
          {
            "name": "chunk_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Chunk Id"
            }
          },
          {
            "name": "context_window",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 3,
              "minimum": 0,
              "default": 1,
              "title": "Context Window"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChunkContextResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/corpus/stats": {
      "get": {
        "summary": "Corpus Stats",
        "operationId": "corpus_stats_api_corpus_stats_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CorpusStats"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/live": {
      "get": {
        "summary": "Live",
        "operationId": "live_api_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Live Api Live Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "tags": [
          "answer audit"
        ],
        "summary": "Live Audit",
        "operationId": "live_audit_api_audit_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuditRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/conversations/examples": {
      "get": {
        "tags": [
          "saved conversations"
        ],
        "summary": "Examples",
        "operationId": "examples_api_conversations_examples_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/conversations/examples/{example_id}": {
      "get": {
        "tags": [
          "saved conversations"
        ],
        "summary": "Replay",
        "operationId": "replay_api_conversations_examples__example_id__get",
        "parameters": [
          {
            "name": "example_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Example Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuditRequest": {
        "properties": {
          "answer": {
            "type": "string",
            "maxLength": 12000,
            "minLength": 1,
            "title": "Answer"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/AuditSource"
            },
            "type": "array",
            "maxItems": 40,
            "minItems": 1,
            "title": "Sources"
          },
          "strategy": {
            "type": "string",
            "enum": [
              "direct",
              "atomic_v2"
            ],
            "title": "Strategy",
            "default": "direct"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "answer",
          "sources"
        ],
        "title": "AuditRequest"
      },
      "AuditSource": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Id"
          },
          "title": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Title"
          },
          "text": {
            "type": "string",
            "maxLength": 50000,
            "minLength": 1,
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "title",
          "text"
        ],
        "title": "AuditSource"
      },
      "ChunkContextResponse": {
        "properties": {
          "chunk": {
            "$ref": "#/components/schemas/ChunkSlim"
          },
          "prev_chunk": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ChunkSlim"
              },
              {
                "type": "null"
              }
            ]
          },
          "next_chunk": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ChunkSlim"
              },
              {
                "type": "null"
              }
            ]
          },
          "document": {
            "additionalProperties": true,
            "type": "object",
            "title": "Document"
          }
        },
        "type": "object",
        "required": [
          "chunk",
          "document"
        ],
        "title": "ChunkContextResponse"
      },
      "ChunkSlim": {
        "properties": {
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          }
        },
        "type": "object",
        "required": [
          "chunk_id",
          "text"
        ],
        "title": "ChunkSlim"
      },
      "CorpusStats": {
        "properties": {
          "total_chunks": {
            "type": "integer",
            "title": "Total Chunks"
          },
          "pubmed_chunks": {
            "type": "integer",
            "title": "Pubmed Chunks"
          },
          "pmc_chunks": {
            "type": "integer",
            "title": "Pmc Chunks"
          },
          "collection": {
            "type": "string",
            "title": "Collection"
          },
          "embedding_model": {
            "type": "string",
            "title": "Embedding Model"
          }
        },
        "type": "object",
        "required": [
          "total_chunks",
          "pubmed_chunks",
          "pmc_chunks",
          "collection",
          "embedding_model"
        ],
        "title": "CorpusStats"
      },
      "DocumentChunkSlim": {
        "properties": {
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id"
          },
          "chunk_idx": {
            "type": "integer",
            "title": "Chunk Idx"
          },
          "section": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Section"
          },
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "chunk_id",
          "chunk_idx",
          "text"
        ],
        "title": "DocumentChunkSlim"
      },
      "DocumentResponse": {
        "properties": {
          "citation": {
            "type": "string",
            "title": "Citation"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "doc_id": {
            "type": "string",
            "title": "Doc Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "pmid": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pmid"
          },
          "external_url": {
            "type": "string",
            "title": "External Url"
          },
          "total_chunks": {
            "type": "integer",
            "title": "Total Chunks"
          },
          "chunks": {
            "items": {
              "$ref": "#/components/schemas/DocumentChunkSlim"
            },
            "type": "array",
            "title": "Chunks"
          }
        },
        "type": "object",
        "required": [
          "citation",
          "source",
          "doc_id",
          "title",
          "pmid",
          "external_url",
          "total_chunks",
          "chunks"
        ],
        "title": "DocumentResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "qdrant": {
            "type": "string",
            "title": "Qdrant"
          },
          "llm": {
            "type": "string",
            "title": "Llm"
          }
        },
        "type": "object",
        "required": [
          "status",
          "qdrant",
          "llm"
        ],
        "title": "HealthResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "ChunkOut": {
        "properties": {
          "chunk_id": {
            "description": "e.g. 'pubmed:12345:0' or 'pmc:doc196:3'",
            "title": "Chunk Id",
            "type": "string"
          },
          "citation": {
            "description": "e.g. 'PMID:12345' or 'PMC:doc196'",
            "title": "Citation",
            "type": "string"
          },
          "source": {
            "description": "'pubmed' or 'pmc'",
            "title": "Source",
            "type": "string"
          },
          "doc_id": {
            "title": "Doc Id",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "section": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Section"
          },
          "pmid": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Pmid"
          },
          "chunk_idx": {
            "title": "Chunk Idx",
            "type": "integer"
          },
          "total_chunks": {
            "title": "Total Chunks",
            "type": "integer"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Score"
          },
          "highlight_ranges": {
            "items": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            "title": "Highlight Ranges",
            "type": "array"
          },
          "external_url": {
            "default": "",
            "title": "External Url",
            "type": "string"
          },
          "authors": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Authors"
          },
          "journal": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Journal"
          },
          "year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Year"
          }
        },
        "required": [
          "chunk_id",
          "citation",
          "source",
          "doc_id",
          "title",
          "chunk_idx",
          "total_chunks",
          "text"
        ],
        "title": "ChunkOut",
        "type": "object"
      }
    }
  }
}

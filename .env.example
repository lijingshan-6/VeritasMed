# Copy to .env (ignored by Git) and fill in your own key.

# ── Flash via an OpenAI-compatible gateway (default backend) ────────────────
LLM_BACKEND=openhub
OPENHUB_BASE_URL=https://www.cun.ai/v1
OPENHUB_API_KEY=your-gateway-key
OPENHUB_MODEL=DeepSeek-V4.1-Flash
OPENHUB_REASONING_EFFORT=high
OPENHUB_MAX_TOKENS=32768
LLM_TIMEOUT_SECONDS=240

# ── Optional local model instead of the gateway ─────────────────────────────
# LLM_BACKEND=ollama
# OLLAMA_MODEL=qwen3.5:9b
# OLLAMA_HOST=http://127.0.0.1:11434

# ── Retrieval (run_demo.py sets these for the bundled three-paper index) ────
# QDRANT_PATH=.demo-runtime/conversation-qdrant
# QDRANT_COLLECTION=medrag_conversation_demo
# QDRANT_URL=http://localhost:6333     # only for a Qdrant server instead of the embedded store
# EMBEDDER_DEVICE=auto                 # auto | cuda | cpu
# RERANKER_DEVICE=auto

# ── Optional MCP server token (local stdio tools only) ──────────────────────
# MEDRAG_LOCAL_TOKEN=replace-with-a-long-random-string

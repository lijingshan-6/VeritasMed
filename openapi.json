  "components": {
    "schemas": {
      "AtomicV2Request": {
        "properties": {
          "answer": {
            "type": "string",
            "maxLength": 12000,
            "minLength": 1,
            "title": "Answer"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/AuditSource"
            },
            "type": "array",
            "maxItems": 40,
            "minItems": 1,
            "title": "Sources"
          },
          "strategy": {
            "type": "string",
            "enum": [
              "direct",
              "split",
              "context",
              "quote_v2",
              "atomic_v1",
              "atomic_v2"
            ],
            "title": "Strategy",
            "default": "direct"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "answer",
          "sources"
        ],
        "title": "AtomicV2Request"
      },
      "AuditSource": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Id"
          },
          "title": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Title"
          },
          "text": {
            "type": "string",
            "maxLength": 50000,
            "minLength": 1,
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "title",
          "text"
        ],
        "title": "AuditSource"
      },
      "ChunkContextResponse": {
        "properties": {
          "chunk": {
            "$ref": "#/components/schemas/ChunkSlim"
          },
          "prev_chunk": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ChunkSlim"
              },
              {
                "type": "null"
              }
            ]
          },
          "next_chunk": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ChunkSlim"
              },
              {
                "type": "null"
              }
            ]
          },
          "document": {
            "additionalProperties": true,
            "type": "object",
            "title": "Document"
          }
        },
        "type": "object",
        "required": [
          "chunk",
          "document"
        ],
        "title": "ChunkContextResponse"
      },
      "ChunkOut": {
        "properties": {
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id",
            "description": "e.g. 'pubmed:12345:0' or 'pmc:doc196:3'"
          },
          "citation": {
            "type": "string",
            "title": "Citation",
            "description": "e.g. 'PMID:12345' or 'PMC:doc196'"
          },
          "source": {
            "type": "string",
            "title": "Source",
            "description": "'pubmed' or 'pmc'"
          },
          "doc_id": {
            "type": "string",
            "title": "Doc Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "section": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Section"
          },
          "pmid": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pmid"
          },
          "chunk_idx": {
            "type": "integer",
            "title": "Chunk Idx"
          },
          "total_chunks": {
            "type": "integer",
            "title": "Total Chunks"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "highlight_ranges": {
            "items": {
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array",
              "maxItems": 2,
              "minItems": 2
            },
            "type": "array",
            "title": "Highlight Ranges"
          },
          "external_url": {
            "type": "string",
            "title": "External Url",
            "default": ""
          },
          "authors": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Authors"
          },
          "journal": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Journal"
          },
          "year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Year"
          }
        },
        "type": "object",
        "required": [
          "chunk_id",
          "citation",
          "source",
          "doc_id",
          "title",
          "chunk_idx",
          "total_chunks",
          "text"
        ],
        "title": "ChunkOut"
      },
      "ChunkSlim": {
        "properties": {
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          }
        },
        "type": "object",
        "required": [
          "chunk_id",
          "text"
        ],
        "title": "ChunkSlim"
      },
      "CorpusStats": {
        "properties": {
          "total_chunks": {
            "type": "integer",
            "title": "Total Chunks"
          },
          "pubmed_chunks": {
            "type": "integer",
            "title": "Pubmed Chunks"
          },
          "pmc_chunks": {
            "type": "integer",
            "title": "Pmc Chunks"
          },
          "collection": {
            "type": "string",
            "title": "Collection"
          },
          "embedding_model": {
            "type": "string",
            "title": "Embedding Model"
          }
        },
        "type": "object",
        "required": [
          "total_chunks",
          "pubmed_chunks",
          "pmc_chunks",
          "collection",
          "embedding_model"
        ],
        "title": "CorpusStats"
      },
      "DocumentChunkSlim": {
        "properties": {
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id"
          },
          "chunk_idx": {
            "type": "integer",
            "title": "Chunk Idx"
          },
          "section": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Section"
          },
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "chunk_id",
          "chunk_idx",
          "text"
        ],
        "title": "DocumentChunkSlim"
      },
      "DocumentResponse": {
        "properties": {
          "citation": {
            "type": "string",
            "title": "Citation"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "doc_id": {
            "type": "string",
            "title": "Doc Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "pmid": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pmid"
          },
          "external_url": {
            "type": "string",
            "title": "External Url"
          },
          "total_chunks": {
            "type": "integer",
            "title": "Total Chunks"
          },
          "chunks": {
            "items": {
              "$ref": "#/components/schemas/DocumentChunkSlim"
            },
            "type": "array",
            "title": "Chunks"
          }
        },
        "type": "object",
        "required": [
          "citation",
          "source",
          "doc_id",
          "title",
          "pmid",
          "external_url",
          "total_chunks",
          "chunks"
        ],
        "title": "DocumentResponse"
      },
      "EvidenceDocument": {
        "properties": {
          "document_id": {
            "type": "string",
            "title": "Document Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "sentences": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Sentences"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "document_id",
          "title",
          "sentences"
        ],
        "title": "EvidenceDocument"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "qdrant": {
            "type": "string",
            "title": "Qdrant"
          },
          "llm": {
            "type": "string",
            "title": "Llm"
          }
        },
        "type": "object",
        "required": [
          "status",
          "qdrant",
          "llm"
        ],
        "title": "HealthResponse"
      },
      "HistoryResponse": {
        "properties": {
          "thread_id": {
            "type": "string",
            "title": "Thread Id"
          },
          "turns": {
            "items": {
              "$ref": "#/components/schemas/HistoryTurn"
            },
            "type": "array",
            "title": "Turns"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          }
        },
        "type": "object",
        "required": [
          "thread_id",
          "turns",
          "summary"
        ],
        "title": "HistoryResponse"
      },
      "HistoryTurn": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "citations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Citations"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "query",
          "answer",
          "citations",
          "timestamp"
        ],
        "title": "HistoryTurn"
      },
      "ResearchRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Question"
          },
          "target_title": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Target Title"
          },
          "claim": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Claim"
          },
          "documents": {
            "items": {
              "$ref": "#/components/schemas/EvidenceDocument"
            },
